---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fullDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.summary} image={`/images/${d.ogImage}`} type="article">
  <header class="post-head">
    <p class="label accent" style="margin:0">Essay / {fullDate(d.date)} / {d.readTime}</p>
    <h1>{d.title}</h1>
    <p class="dek">{d.summary}</p>
  </header>
  <div class="post">
    <nav class="toc" aria-label="Contents">
      <div class="label strong">Contents</div>
      {headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <article class="prose"><Content /></article>
  </div>
</Base>
