---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fullDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.summary} image={`/images/${d.ogImage}`} type="article">
  <header class="post-head">
    <p class="label accent" style="margin:0">Essay / {fullDate(d.date)} / {d.readTime}</p>
    <h1>{d.title}</h1>
    <p class="dek">{d.summary}</p>
  </header>
  <div class="post">
    <nav class="toc" aria-label="Contents">
      <div class="label strong">Contents</div>
      {headings.filter((h) => h.depth === 2).map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <article class="prose"><Content /></article>
  </div>
  <script>
    // mark the section being read in the contents rail
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))!);
    const mark = () => {
      const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
      const at = atEnd ? heads.length - 1 : heads.findLastIndex((h) => h.getBoundingClientRect().top < 120);
      links.forEach((a, i) => a.classList.toggle('on', i === at));
    };
    addEventListener('scroll', mark, { passive: true });
    mark();
  </script>
</Base>
