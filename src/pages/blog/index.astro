---
import Base from '../../layouts/Base.astro';
import { getPosts, fullDate } from '../../lib/site';
const posts = await getPosts();
---
<Base title="Writing" description="Essays by Adam Bloebaum on biomechanics, motor learning, and training.">
  <div class="index-head"><h1 class="page-title">Writing</h1></div>
  <div class="section-head" style="margin-top:40px"><h2>Essays</h2></div>
  <div class="rows">
    {posts.map((p, i) => (
      <a href={`/blog/${p.id}`}>
        <span class="no"><b>{String(posts.length - i).padStart(2, '0')}</b></span>
        <span class="main"><strong>{p.data.title}</strong><span>{p.data.summary}</span></span>
        <span class="meta label">{fullDate(p.data.date)}<br />{p.data.readTime}</span>
      </a>
    ))}
  </div>
</Base>
