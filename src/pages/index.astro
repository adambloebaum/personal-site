---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import PostList from '../components/PostList.astro';
import { getWorks, getPosts } from '../lib/site';

const research = (await getWorks()).filter((w) => w.data.type === 'publication').slice(0, 3);
const posts = await getPosts();
---
<Base>
  <section class="hero">
    <div class="words">
      <p class="label accent" style="margin:0">Biomechanics / Measurement / Pitching</p>
      <h1>I build the measurement and models behind player development, <em>and I pitch with them.</em></h1>
      <p class="dek">Applied quantitative engineer at Driveline Baseball. Pitcher in the Washington Nationals system. Physics by training.</p>
    </div>
    <figure>
      <svg viewBox="0 0 440 280" role="img" aria-label="Schematic of proximal-to-distal sequencing: pelvis, trunk, and arm rotation speeds peaking in order between foot plant and ball release">
        <g stroke="#1F2A30" stroke-opacity="0.18">
          <line x1="40" y1="40" x2="420" y2="40" /><line x1="40" y1="100" x2="420" y2="100" /><line x1="40" y1="160" x2="420" y2="160" /><line x1="40" y1="220" x2="420" y2="220" />
          <line x1="135" y1="24" x2="135" y2="236" /><line x1="230" y1="24" x2="230" y2="236" /><line x1="325" y1="24" x2="325" y2="236" />
        </g>
        <path d="M40 220 C110 218 130 150 175 150 C215 150 235 214 420 220" fill="none" stroke="#2F6F73" stroke-width="2.5" />
        <path d="M40 220 C150 220 190 108 240 108 C285 108 300 212 420 220" fill="none" stroke="#B8862B" stroke-width="2.5" />
        <path d="M40 220 C220 220 262 44 300 44 C335 44 345 200 420 216" fill="none" stroke="#A4472B" stroke-width="2.5" />
        <line x1="40" y1="24" x2="40" y2="236" stroke="#1F2A30" stroke-width="1.5" />
        <line x1="40" y1="236" x2="420" y2="236" stroke="#1F2A30" stroke-width="1.5" />
        <text x="42" y="262" font-family="Barlow Condensed, sans-serif" font-size="13" letter-spacing="1.5" fill="#3B4649">FOOT PLANT</text>
        <text x="330" y="262" font-family="Barlow Condensed, sans-serif" font-size="13" letter-spacing="1.5" fill="#3B4649">BALL RELEASE</text>
      </svg>
      <figcaption class="label">
        <span><i style="background:#2F6F73"></i>Pelvis</span>
        <span><i style="background:#B8862B"></i>Trunk</span>
        <span><i style="background:#A4472B"></i>Arm</span>
        <span class="note">Schematic: rotation speed, proximal to distal</span>
      </figcaption>
    </figure>
  </section>

  <dl class="facts">
    <div><dt>Engineer</dt><dd>Driveline Baseball</dd></div>
    <div><dt>Pitcher</dt><dd>Washington Nationals, MiLB</dd></div>
    <div><dt>BS Physics</dt><dd>Univ. of Washington</dd></div>
    <div><dt>MS Analytics, in progress</dt><dd>Georgia Tech</dd></div>
  </dl>

  <div class="section-head"><h2>Selected research</h2><a class="label" href="/works">All work</a></div>
  <div class="plates">{research.map((w) => <Plate work={w} />)}</div>

  <div class="section-head"><h2>Writing</h2><a class="label" href="/rss.xml">RSS</a></div>
  <PostList posts={posts} />
</Base>
