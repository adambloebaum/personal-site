---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import PostList from '../components/PostList.astro';
import { getWorks, getPosts, kinds } from '../lib/site';

const figures = import.meta.glob<string>('../assets/works/*.svg', { query: '?raw', import: 'default', eager: true });
const figureOf = (id: string) => figures[`../assets/works/${id}.svg`];
const papers = (await getWorks()).filter((w) => w.data.type === 'publication');
// the newest paper that has a figure leads the page; the rest follow below
const lead = papers.find((w) => figureOf(w.id))!;
const research = papers.filter((w) => w !== lead).slice(0, 3);
const posts = await getPosts();
---
<Base>
  <h1 class="sr-only">Adam Bloebaum</h1>
  <section class="lead">
    <dl class="status">
      <div><dt>Currently</dt><dd>Applied quantitative engineer, Driveline Baseball</dd></div>
      <div><dt>Building</dt><dd>Biomechanics models, computer vision tools, data pipelines</dd></div>
      <div><dt>Also</dt><dd>Pitcher, Washington Nationals system</dd></div>
      <div><dt>Studying</dt><dd>MS Analytics, Georgia Tech</dd></div>
      <div><dt>Trained in</dt><dd>BS Physics, University of Washington</dd></div>
    </dl>
    <a class="plate feature" href={`/works/${lead.id}`}>
      <div class="figure"><Fragment set:html={figureOf(lead.id)} /></div>
      <div class="body">
        <span class="label">Newest / Plate {lead.plate} / {kinds[lead.data.type].one} / {lead.data.date.getUTCFullYear()}</span>
        <h3>{lead.data.short}</h3>
        <div class="label">{lead.data.sample.join(' / ')}</div>
      </div>
    </a>
  </section>

  <div class="section-head"><h2>More research</h2><a class="label" href="/works">All work</a></div>
  <div class="plates">{research.map((w) => <Plate work={w} />)}</div>

  <div class="section-head"><h2>Writing</h2></div>
  <PostList posts={posts} />
</Base>
