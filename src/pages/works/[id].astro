---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getWorks, kinds, fullDate } from '../../lib/site';

export async function getStaticPaths() {
  return (await getWorks()).map((work) => ({ params: { id: work.id }, props: { work } }));
}
const { work } = Astro.props;
const d = work.data;
const kind = kinds[d.type];
const href = d.url ?? d.pdfUrl;
const figure = import.meta.glob<string>('../../assets/works/*.svg', { query: '?raw', import: 'default', eager: true })[`../../assets/works/${work.id}.svg`];
const { Content } = await render(work);
const cta = { publication: 'Read the preprint', patent: 'Read the application', project: 'View the code' }[d.type];
---
<Base title={d.short} description={d.summary} type="article">
  <div class={`banner hatch-${d.type}`}>
    <a class="tag" href="/works/">{[...new Set([kind.label, `#${+work.plate}`, kind.one])].join(' / ')}</a>
  </div>
  <section class="work-top">
    <div class="words">
      <h1>{d.short}</h1>
      {d.type === 'publication' && <p class="published">Published as: {d.title}</p>}
      {href && <a class="button" href={href}>{cta}</a>}
    </div>
    <dl class="panel">
      {d.sample.length > 0 && <div><dt>Sample</dt><dd>{d.sample.join(', ')}</dd></div>}
      {d.method && <div><dt>Method</dt><dd>{d.method}</dd></div>}
      <div><dt>Published</dt><dd>{d.venue}, {fullDate(d.date)}</dd></div>
    </dl>
  </section>
  {figure && (
    <figure class="fig">
      <Fragment set:html={figure} />
      {d.figureCaption && <figcaption><span class="label">Fig. 1</span>{d.figureCaption}</figcaption>}
    </figure>
  )}
  <section class="two">
    <div><h2>Summary</h2><Content /></div>
  </section>
</Base>
